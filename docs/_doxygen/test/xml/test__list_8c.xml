<codeline lineno="49"><highlight class="normal"></highlight><highlight class="keyword">static</highlight><highlight class="normal"><sp/></highlight><highlight class="keywordtype">void</highlight><highlight class="normal"><sp/>lst_append(t_list<sp/>**head,<sp/>t_list<sp/>*node)</highlight></codeline>
<codeline lineno="50"><highlight class="normal">{</highlight></codeline>
