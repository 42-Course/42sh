<codeline lineno="35"><highlight class="normal">}</highlight></codeline>
<codeline lineno="36"><highlight class="normal"></highlight></codeline>
<codeline lineno="37"><highlight class="normal"></highlight><highlight class="keyword">static</highlight><highlight class="normal"><sp/></highlight><highlight class="keywordtype">void</highlight><highlight class="normal"><sp/>del_dummy(</highlight><highlight class="keywordtype">void</highlight><highlight class="normal"><sp/>*content)</highlight></codeline>
<codeline lineno="38"><highlight class="normal">{</highlight></codeline>
