        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Run all doubly-linked list assertions.</para>
<para>Builds a three-node list <computeroutput>[1 &lt;-&gt; 2 &lt;-&gt; 3]</computeroutput>, verifies size, forward and backward links, sentinel NULL values at both ends, then calls ft_dlstclear() and asserts the head pointer is NULL afterwards. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="test_runner.c" line="28" column="5" bodyfile="test_dlist.c" bodystart="30" bodyend="59" declfile="test_runner.c" declline="28" declcolumn="5"/>
      </memberdef>
      <memberdef kind="function" id="test__runner_8c_1ad88047b8cb23d2d51d9b331a013b922f" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
